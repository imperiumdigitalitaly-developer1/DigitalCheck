# DigitalCheck — variabili d'ambiente
# Copia questo file in .env.local e compila almeno DATABASE_URL e AUTH_SECRET.
# Ogni integrazione mancante viene gestita in modo esplicito (mai simulata):
# vedi README.md, sezione "API/servizi esterni necessari".

# --- Obbligatorie -----------------------------------------------------

# Postgres (Supabase, Neon, RDS, ...)
DATABASE_URL="postgresql://user:password@host:5432/digitalcheck"

# Segreto usato per firmare le sessioni (JWT). Generane uno lungo e casuale,
# es. `openssl rand -base64 48`.
AUTH_SECRET="cambia-questo-valore"

# URL pubblico dell'app, usato per i link di verifica/reset e i redirect
# di Stripe Checkout. In sviluppo puo' restare quello di default.
NEXT_PUBLIC_APP_URL="https://digitalcheck.imperiumdigitalitalia.it"

# --- Analisi tecnica ----------------------------------------------------

# Google PageSpeed Insights: senza questa chiave il punteggio Performance
# ricade su una stima approssimativa (dichiarata come tale nel report).
PAGESPEED_API_KEY=""

# Pagine massime analizzate per scan, per piano (fallback se la tabella
# UsageLimit non e' ancora popolata — vedi prisma/seed.ts).
SCAN_MAX_PAGES_FREE=5
SCAN_MAX_PAGES_PRO=20

# --- Intelligenza artificiale --------------------------------------------

# Provider LLM (attualmente Google Gemini). Senza questa chiave l'analisi
# tecnica resta disponibile, ma l'interpretazione AI e l'Assistente AI
# rispondono con un messaggio esplicito di non disponibilita', non con
# un'analisi finta.
AI_API_KEY=""
AI_MODEL="gemini-3.6-flash"

# --- Pagamenti (Stripe) ---------------------------------------------------

# Senza queste variabili, il checkout risponde con un errore esplicito
# invece di un link finto. Il piano Pro costa 6,99 EUR/mese: crea un
# Price ricorrente su Stripe con quell'importo e incollane l'ID qui sotto.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID_PRO=""
STRIPE_WEBHOOK_SECRET=""

# --- Email transazionale (verifica account, reset password) --------------

# Senza RESEND_API_KEY le email non vengono inviate: in sviluppo il link
# compare direttamente nella risposta API per poter testare il flusso.
RESEND_API_KEY=""
EMAIL_FROM="DigitalCheck <no-reply@tuodominio.it>"

# --- Monitoraggio periodico (cron) ----------------------------------------

# Segreto condiviso richiesto dall'header Authorization di /api/cron/rescan
# (Vercel Cron o uno scheduler esterno equivalente).
CRON_SECRET=""

# --- Gestionale: integrazioni Analytics / Search Console ------------------
#
# Il flusso OAuth (redirect + callback, vedi src/app/api/gestionale/
# connections/[provider]/{connect,callback}) e' implementato ed e'
# multi-tenant: ogni sito autorizza il proprio account Google in modo
# indipendente (AnalyticsConnection/SearchConsoleConnection hanno un
# siteId @unique, un token per sito, mai condiviso). Le credenziali sotto
# sono quelle dell'app OAuth di Imperium Digital (una sola, registrata su
# Google Cloud Console) contro cui ogni cliente si autentica. Finche' non
# sono configurate, il Gestionale mostra "Connessione richiesta" con il
# pulsante di collegamento disabilitato, mai dati finti.
#
# Redirect URI da registrare in Google Cloud Console (Credenziali OAuth
# 2.0 → URI di reindirizzamento autorizzati), sostituendo l'URL di
# produzione:
#   {NEXT_PUBLIC_APP_URL}/api/gestionale/connections/analytics/callback
#   {NEXT_PUBLIC_APP_URL}/api/gestionale/connections/search-console/callback

# Google Analytics (Data API) — OAuth, scope analytics.readonly
GOOGLE_ANALYTICS_CLIENT_ID=""
GOOGLE_ANALYTICS_CLIENT_SECRET=""

# Google Search Console (Search Console API) — OAuth, scope webmasters.readonly
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=""
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=""

# UptimeRobot (Observability, API v2) — Main API Key dell'account
# Imperium Digital. Alla creazione di un sito (piano Pro) viene creato
# automaticamente un monitor HTTP(s) su UptimeRobot per quell'URL e l'ID
# restituito viene salvato su MonitoringConfig.monitorId; alla cancellazione
# del sito il monitor corrispondente viene eliminato, per non lasciare
# monitor orfani a consumare la quota dell'account. Senza questa chiave la
# tab Observability del Gestionale mostra "Monitoring non ancora
# configurato" (mai dati finti), e per i siti gia' esistenti resta
# disponibile il pulsante per collegare il monitor manualmente non appena
# la chiave viene configurata.
UPTIMEROBOT_API_KEY=""
