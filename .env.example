# DigitalCheck — variabili d'ambiente
# Copia questo file in .env.local e compila almeno DATABASE_URL e AUTH_SECRET.
# Ogni integrazione mancante viene gestita in modo esplicito (mai simulata):
# vedi README.md, sezione "API/servizi esterni necessari".

# --- Obbligatorie -----------------------------------------------------

# Postgres (Supabase, Neon, RDS, ...)
DATABASE_URL="postgresql://user:password@host:5432/digitalcheck"

# Segreto usato per firmare le sessioni (JWT). Generane uno lungo e casuale,
# es. `openssl rand -base64 48`.
AUTH_SECRET="cambia-questo-valore"

# URL pubblico dell'app, usato per i link di verifica/reset e i redirect
# di Stripe Checkout. In sviluppo puo' restare quello di default.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Analisi tecnica ----------------------------------------------------

# Google PageSpeed Insights: senza questa chiave il punteggio Performance
# ricade su una stima approssimativa (dichiarata come tale nel report).
PAGESPEED_API_KEY=""

# Pagine massime analizzate per scan, per piano (fallback se la tabella
# UsageLimit non e' ancora popolata — vedi prisma/seed.ts).
SCAN_MAX_PAGES_FREE=5
SCAN_MAX_PAGES_PRO=20

# --- Intelligenza artificiale --------------------------------------------

# Provider LLM (attualmente Google Gemini). Senza questa chiave l'analisi
# tecnica resta disponibile, ma l'interpretazione AI e l'Assistente AI
# rispondono con un messaggio esplicito di non disponibilita', non con
# un'analisi finta.
AI_API_KEY=""
AI_MODEL="gemini-3.6-flash"

# --- Pagamenti (Stripe) ---------------------------------------------------

# Senza queste variabili, il checkout risponde con un errore esplicito
# invece di un link finto. Il piano Pro costa 6,99 EUR/mese: crea un
# Price ricorrente su Stripe con quell'importo e incollane l'ID qui sotto.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID_PRO=""
STRIPE_WEBHOOK_SECRET=""

# --- Email transazionale (verifica account, reset password) --------------

# Senza RESEND_API_KEY le email non vengono inviate: in sviluppo il link
# compare direttamente nella risposta API per poter testare il flusso.
RESEND_API_KEY=""
EMAIL_FROM="DigitalCheck <no-reply@tuodominio.it>"

# --- Monitoraggio periodico (cron) ----------------------------------------

# Segreto condiviso richiesto dall'header Authorization di /api/cron/rescan
# (Vercel Cron o uno scheduler esterno equivalente).
CRON_SECRET=""

# --- Gestionale: integrazioni future (non implementate in questo ambiente) -
#
# L'architettura (modelli AnalyticsConnection/SearchConsoleConnection/
# MonitoringConfig in prisma/schema.prisma, tab dedicate nel Gestionale) e'
# gia' pronta a collegare questi servizi: finche' le variabili sotto non
# sono configurate e il relativo flusso OAuth/API non e' implementato, il
# Gestionale mostra sempre "Connessione richiesta" / "Non configurato",
# mai dati finti.

# Google Analytics (Data API) — OAuth
GOOGLE_ANALYTICS_CLIENT_ID=""
GOOGLE_ANALYTICS_CLIENT_SECRET=""

# Google Search Console (Search Console API) — OAuth
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=""
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=""

# Provider di uptime monitoring (es. UptimeRobot, Better Uptime, Checkly)
MONITORING_PROVIDER_API_KEY=""
