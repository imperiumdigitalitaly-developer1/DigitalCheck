// Schema Fase 2 (persistenza). In Fase 1 l'app e' stateless: questo
// schema e' predisposto ora cosi' che il passaggio a Fase 2 non richieda
// di ridisegnare le entita' del dominio (scan, score, issue, ecc.),
// solo di collegare un DATABASE_URL reale e attivare `prisma migrate`.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanType {
  FREE
  PRO
}

enum ScanStatus {
  REQUESTED
  CRAWLING
  ANALYZING
  AI_PROCESSING
  SCORING
  COMPLETED
  FAILED
}

enum IssueSeverity {
  HIGH
  MEDIUM
  LOW
}

enum BusinessType {
  BNB
  HOTEL
  RESTAURANT
  SHOP
  PROFESSIONAL
  OTHER
}

enum UsageEventType {
  SCAN
  NEW_SITE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  emailVerified DateTime?
  isAdmin       Boolean   @default(false)
  plan          PlanType  @default(FREE)

  // Token per reset password / verifica email: salviamo solo l'hash,
  // mai il token in chiaro, cosi' un accesso al database non basta a
  // impersonare un utente. Vedi src/lib/auth/tokens.ts.
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  emailVerifyTokenHash   String?
  emailVerifyExpiresAt   DateTime?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  organizations Organization[]
  sites         Site[]
  notifications Notification[]
  subscription  Subscription?
  usageEvents   UsageEvent[]
}

// Registro append-only dei consumi di quota (un'analisi eseguita, un
// nuovo sito creato). Deliberatamente NON collegato a Scan/Site: se quella
// riga viene eliminata, la quota gia' consumata nel periodo corrente deve
// restare tale, altrimenti eliminare un sito libererebbe quota analisi/
// nuovi-siti gia' usata (vedi countScansThisWeek/Month e
// countSitesThisMonth in src/lib/billing/plan-limits.ts, che leggono da
// qui invece che contare le righe Scan/Site esistenti).
model UsageEvent {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      UsageEventType
  createdAt DateTime       @default(now())

  @@index([userId, type, createdAt])
}

// Un utente puo' avere piu' organizzazioni in futuro (es. agenzia che
// gestisce siti per conto di piu' clienti). In Fase 1/2 un utente ne ha
// tipicamente una sola, creata implicitamente alla registrazione.
model Organization {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sites     Site[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Site {
  id             String        @id @default(cuid())
  url            String
  businessType   BusinessType
  goal           String
  ownerId        String
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  scans          Scan[]

  // Monitoraggio periodico (piano Pro). nextScanAt e' letto dal job di
  // cron: vedi src/app/api/cron/rescan/route.ts.
  monitoringEnabled Boolean   @default(false)
  scanFrequencyDays Int       @default(7)
  nextScanAt        DateTime?

  analyticsConnection     AnalyticsConnection?
  searchConsoleConnection SearchConsoleConnection?
  monitoringConfig        MonitoringConfig?
  aiConversations         AIConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([monitoringEnabled, nextScanAt])
}

model Scan {
  id                    String     @id @default(cuid())
  siteId                String
  site                  Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  status                ScanStatus @default(REQUESTED)
  overallScore          Int?
  pagesCrawled          Int        @default(0)
  businessImpactSummary String?
  strengths             String[]   @default([])
  unverifiable          String[]   @default([])

  // Interpretazione AI completa (sezione 12/33 del brief): salvata qui
  // cosi' un report ricostruito da uno scan storico (PDF, pagina di
  // dettaglio) resta identico a quello mostrato subito dopo lo scan,
  // invece di perdere l'analisi AI dopo la persistenza.
  aiConversionAnalysis String?
  aiContentAnalysis    String?
  aiPriorities         String[] @default([])

  errorCode       String?
  errorMessage    String?
  retryCount      Int              @default(0)
  startedAt       DateTime         @default(now())
  completedAt     DateTime?
  scores          ScanScore[]
  issues          ScanIssue[]
  recommendations Recommendation[]
  reports         Report[]

  @@index([siteId, startedAt])
}

// Un punteggio per categoria (SEO, Performance, Mobile, ...) per scan.
model ScanScore {
  id       String @id @default(cuid())
  scanId   String
  scan     Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  category String
  score    Int
  weight   Float

  @@index([scanId])
}

model ScanIssue {
  id             String        @id @default(cuid())
  scanId         String
  scan           Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  title          String
  description    String
  whyItMatters   String
  recommendation String
  evidence       String?
  category       String
  severity       IssueSeverity
  createdAt      DateTime      @default(now())

  @@index([scanId])
}

model Recommendation {
  id        String   @id @default(cuid())
  scanId    String
  scan      Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  title     String
  detail    String
  priority  Int
  createdAt DateTime @default(now())

  @@index([scanId])
}

model Report {
  id         String   @id @default(cuid())
  scanId     String
  scan       Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  pdfUrl     String?
  publicSlug String?  @unique
  createdAt  DateTime @default(now())
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  plan                 PlanType  @default(FREE)
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// Limiti per piano, letti a runtime — mai hardcoded nella logica applicativa.
// maxScansWeek e maxSitesMonth si applicano solo al piano Free (1 analisi a
// settimana, 1 sito nuovo al mese); per il piano Pro restano null e non
// vengono applicati (siti illimitati, cap solo mensile via maxScansMonth).
model UsageLimit {
  id            String   @id @default(cuid())
  plan          PlanType @unique
  maxSites      Int
  maxScansMonth Int
  maxPagesScan  Int
  maxScansWeek  Int?
  maxSitesMonth Int?
  updatedAt     DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------
// Gestionale (piano Pro): integrazioni esterne e monitoraggio.
// Questi modelli esistono per rendere l'architettura pronta a collegare
// un provider reale (OAuth Google Analytics/Search Console, un servizio
// di uptime monitoring) — finche' non vengono configurate le credenziali
// necessarie, `connected` resta false e il Gestionale mostra
// esplicitamente "Connessione richiesta", mai dati finti.
// ---------------------------------------------------------------------

model AnalyticsConnection {
  id           String    @id @default(cuid())
  siteId       String    @unique
  site         Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  connected    Boolean   @default(false)
  propertyId   String?
  accessToken  String?
  refreshToken String?
  connectedAt  DateTime?
  updatedAt    DateTime  @updatedAt
}

model SearchConsoleConnection {
  id           String    @id @default(cuid())
  siteId       String    @unique
  site         Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  connected    Boolean   @default(false)
  // Proprieta' Search Console scelta dall'utente tra quelle restituite da
  // sites.list (un account puo' averne piu' di una) — vedi
  // src/lib/gestionale/search-console.ts. null finche' non viene scelta:
  // "connesso" (token valido) e "proprieta' selezionata" sono stati
  // distinti, mostrati separatamente nel Gestionale.
  siteUrl              String?
  accessToken          String?
  refreshToken         String?
  // Scadenza dell'accessToken corrente: permette di rinnovarlo in modo
  // proattivo (vedi getValidSearchConsoleToken) invece di scoprirlo solo
  // dopo una risposta 401 da Google.
  accessTokenExpiresAt DateTime?
  connectedAt          DateTime?
  updatedAt            DateTime  @updatedAt
}

model MonitoringConfig {
  id         String   @id @default(cuid())
  siteId     String   @unique
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  configured Boolean  @default(false)
  provider   String?
  checkUrl   String?
  // ID del monitor sul provider esterno (es. UptimeRobot) — vedi
  // src/lib/integrations/uptimerobot.ts. Stringa, non Int: gli ID
  // UptimeRobot sono interi grandi e qui contano solo come riferimento
  // opaco, mai per calcoli. `configured` resta true solo quando questo
  // campo e' valorizzato (il monitor esiste davvero sul provider).
  monitorId  String?
  updatedAt  DateTime @updatedAt
}

// Storico della conversazione con l'assistente AI per sito (piano Pro):
// permette di riprendere il contesto invece di perderlo a ogni refresh.
model AIConversation {
  id        String      @id @default(cuid())
  siteId    String
  site      Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AIMessage[]

  @@index([siteId, userId])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  text           String
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}
