// Schema Fase 2 (persistenza). In Fase 1 l'app e' stateless: questo
// schema e' predisposto ora cosi' che il passaggio a Fase 2 non richieda
// di ridisegnare le entita' del dominio (scan, score, issue, ecc.),
// solo di collegare un DATABASE_URL reale e attivare `prisma migrate`.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanType {
  FREE
  PRO
}

enum ScanStatus {
  REQUESTED
  CRAWLING
  ANALYZING
  AI_PROCESSING
  SCORING
  COMPLETED
  FAILED
}

// CRITICAL e INFO aggiunti per il sistema di audit multi-categoria (brief
// "audit professionale", sezione 41: severita' centralizzata a 5 livelli).
// HIGH/MEDIUM/LOW restano invariati: dati storici e ScanIssue esistenti
// non vengono toccati, e' un'estensione additiva dell'enum.
enum IssueSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum BusinessType {
  BNB
  HOTEL
  RESTAURANT
  SHOP
  PROFESSIONAL
  OTHER
}

enum UsageEventType {
  SCAN
  NEW_SITE
}

// Le 8 dimensioni GEO core (brief sezione 13) + LOCAL_GEO, applicabile solo
// alle attivita' locali (brief sezione 9): quando non applicabile il suo
// peso viene redistribuito sulle altre, non semplicemente azzerato — vedi
// src/lib/geo/geo-weights.ts.
enum GeoCategoryKey {
  AI_ACCESSIBILITY
  SEMANTIC_UNDERSTANDING
  ENTITY_CLARITY
  INFORMATION_COMPLETENESS
  ANSWERABILITY
  CONTENT_STRUCTURE
  TRUST_SIGNALS
  STRUCTURED_DATA
  LOCAL_GEO
}

// Severita' a 4 livelli per gli issue GEO (brief sezione 16: Critical/High/
// Medium/Low + "Good", quest'ultimo pero' rappresentato come una voce di
// GeoAnalysis.strengths, non come severita' di un problema). Enum separato
// da IssueSeverity (usato da ScanIssue) per non alterarne la semantica
// consolidata sui dati SEO gia' in produzione.
enum GeoIssueSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  emailVerified DateTime?
  isAdmin       Boolean   @default(false)
  plan          PlanType  @default(FREE)

  // Token per reset password / verifica email: salviamo solo l'hash,
  // mai il token in chiaro, cosi' un accesso al database non basta a
  // impersonare un utente. Vedi src/lib/auth/tokens.ts.
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  emailVerifyTokenHash   String?
  emailVerifyExpiresAt   DateTime?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  organizations Organization[]
  sites         Site[]
  notifications Notification[]
  subscription  Subscription?
  usageEvents   UsageEvent[]
}

// Registro append-only dei consumi di quota (un'analisi eseguita, un
// nuovo sito creato). Deliberatamente NON collegato a Scan/Site: se quella
// riga viene eliminata, la quota gia' consumata nel periodo corrente deve
// restare tale, altrimenti eliminare un sito libererebbe quota analisi/
// nuovi-siti gia' usata (vedi countScansThisWeek/Month e
// countSitesThisMonth in src/lib/billing/plan-limits.ts, che leggono da
// qui invece che contare le righe Scan/Site esistenti).
model UsageEvent {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      UsageEventType
  createdAt DateTime       @default(now())

  @@index([userId, type, createdAt])
}

// Un utente puo' avere piu' organizzazioni in futuro (es. agenzia che
// gestisce siti per conto di piu' clienti). In Fase 1/2 un utente ne ha
// tipicamente una sola, creata implicitamente alla registrazione.
model Organization {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sites     Site[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Site {
  id             String        @id @default(cuid())
  url            String
  businessType   BusinessType
  goal           String
  ownerId        String
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  scans          Scan[]

  // Monitoraggio periodico (piano Pro). nextScanAt e' letto dal job di
  // cron: vedi src/app/api/cron/rescan/route.ts.
  monitoringEnabled Boolean   @default(false)
  scanFrequencyDays Int       @default(7)
  nextScanAt        DateTime?

  analyticsConnection     AnalyticsConnection?
  searchConsoleConnection SearchConsoleConnection?
  monitoringConfig        MonitoringConfig?
  aiConversations         AIConversation[]
  notifications           Notification[]
  aiResponseCache         AiResponseCache[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([monitoringEnabled, nextScanAt])
}

// Cache delle risposte dell'AI Assistant (gestione errori AI e cache
// analisi, punto B): evita di richiamare Gemini per una domanda equivalente
// gia' posta sullo stesso sito per la stessa scansione, cosi' non si
// consuma altra quota condivisa per un risultato che sarebbe identico.
// `key` e' l'unico campo interrogato in lettura/scrittura (sha256 di
// siteId + ultimo scanId + domanda normalizzata) — vedi
// src/lib/ai/response-cache.ts. onDelete Cascade dal Site: quando un sito
// viene eliminato non deve restare cache orfana collegata a un sito che
// non esiste piu'.
model AiResponseCache {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  key       String   @unique
  response  String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([siteId])
  @@index([expiresAt])
}

model Scan {
  id                    String     @id @default(cuid())
  siteId                String
  site                  Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  status                ScanStatus @default(REQUESTED)
  // overallScore e' il DigitalCheck Score complessivo (audit brief, sezione
  // 13): media pesata delle 7 categorie SEO-side + GEO, non solo SEO-side
  // come nella versione precedente del prodotto — vedi
  // src/lib/analysis/master-score.ts per la metodologia documentata.
  overallScore          Int?
  pagesCrawled          Int        @default(0)
  businessImpactSummary String?
  strengths             String[]   @default([])
  unverifiable          String[]   @default([])

  // Interpretazione AI completa (sezione 12/33 del brief): salvata qui
  // cosi' un report ricostruito da uno scan storico (PDF, pagina di
  // dettaglio) resta identico a quello mostrato subito dopo lo scan,
  // invece di perdere l'analisi AI dopo la persistenza.
  aiConversionAnalysis String?
  aiContentAnalysis    String?
  aiPriorities         String[] @default([])

  // Interpretazione AI a livello di intero audit (brief audit, sezioni 17
  // "Executive Summary" e 26 "Cross-Analysis"): generata una sola volta per
  // scan a partire dai risultati GIA' calcolati delle 8 categorie (mai
  // dati inventati — vedi src/lib/ai/audit-analyzer.ts). auditCrossAnalysis
  // e' un array di correlazioni {pairLabel, note}; forma libera perche' il
  // numero di correlazioni emesse dipende dai dati di QUESTO scan.
  auditExecutiveSummary String?
  auditCrossAnalysis    Json?
  // Segnale esplicito e inequivocabile che l'interpretazione AI dell'audit
  // e' riuscita per questo scan (brief redesign PDF sezione 19-20): NON
  // deducibile da auditExecutiveSummary, che ha sempre un valore (anche di
  // fallback deterministico) — serve un booleano dedicato perche' il PDF
  // sappia con certezza quando mostrare il blocco "temporaneamente non
  // disponibile" invece di contenuti AI a meta'.
  auditAiAvailable            Boolean  @default(false)
  auditQuickWins               String[] @default([])
  auditStrategicImprovements   String[] @default([])
  auditFinalAssessment         String?

  errorCode       String?
  errorMessage    String?
  retryCount      Int              @default(0)
  startedAt       DateTime         @default(now())
  completedAt     DateTime?
  scores          ScanScore[]
  issues          ScanIssue[]
  recommendations Recommendation[]
  reports         Report[]
  geoAnalysis     GeoAnalysis?

  @@index([siteId, startedAt])
}

// ---------------------------------------------------------------------
// GEO (Generative Engine Optimization): predisposizione del sito a essere
// compreso, citato e sintetizzato da motori di ricerca generativi e AI
// answer engine. Deliberatamente un modello separato da ScanScore/ScanIssue
// (brief sezione 2: "GEO non deve essere una copia della SEO"), ma agganciato
// 1:1 allo stesso Scan — stessa fonte dati di crawl, nessuna doppia
// architettura (brief sezione 28).
// ---------------------------------------------------------------------

model GeoAnalysis {
  id              String  @id @default(cuid())
  scanId          String  @unique
  scan            Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  overallScore    Int
  localApplicable Boolean @default(false)

  // Segnali positivi rilevati (analogo a Scan.strengths) — corrispondono al
  // livello "Good" della sezione 16 del brief, mai rappresentato come
  // severita' di un GeoIssue.
  strengths String[] @default([])

  // Dati semi-strutturati e contestuali (brief sezioni 3-5): forma libera
  // perche' la forma cambia per tipo di attivita' (un B&B ha indirizzo/
  // check-in, un professionista ha albo/qualifiche) — vedi
  // src/lib/geo/geo-types.ts per la shape TypeScript che li descrive.
  entities                Json // EntityData: brand, organizzazione, contatti, schema rilevati, sameAs
  informationCompleteness Json // InformationCompletenessItem[]: domanda -> risposta rilevata / mancante
  answerabilityQueries    Json // AnswerabilityQuery[]: query generate dal contenuto reale + risposta trovata o no

  // Interpretazione AI (facoltativa, Pro): mai generata senza i dati sopra
  // gia' calcolati — l'AI interpreta, non sostituisce l'analisi tecnica
  // (brief sezione 36).
  aiSummary        String?
  aiComparisonNote String? // confronto dinamico SEO vs GEO (brief sezione 19/39)
  // Frase sintetica per la dashboard executive dell'audit multi-categoria
  // (brief audit sezione 14), parallela a ScanScore.shortSummary per le
  // altre 7 categorie.
  shortSummary     String?

  createdAt DateTime @default(now())

  categoryScores GeoCategoryScore[]
  issues         GeoIssue[]
}

model GeoCategoryScore {
  id            String         @id @default(cuid())
  geoAnalysisId String
  geoAnalysis   GeoAnalysis    @relation(fields: [geoAnalysisId], references: [id], onDelete: Cascade)
  category      GeoCategoryKey
  score         Int
  weight        Float
  // false solo per LOCAL_GEO su attivita' non locali: la riga resta per
  // trasparenza ("perche' ho 63/100" — brief sezione 37) ma score/weight
  // non entrano nella somma pesata (weight persistito e' 0 in quel caso).
  applicable    Boolean        @default(true)
  notes         String?

  @@index([geoAnalysisId])
}

model GeoIssue {
  id             String           @id @default(cuid())
  geoAnalysisId  String
  geoAnalysis    GeoAnalysis      @relation(fields: [geoAnalysisId], references: [id], onDelete: Cascade)
  category       GeoCategoryKey
  title          String
  description    String
  whyItMatters   String
  recommendation String
  example        String?
  severity       GeoIssueSeverity
  createdAt      DateTime         @default(now())

  @@index([geoAnalysisId])
}

// Un punteggio per categoria (SEO, Performance, Mobile, ...) per scan —
// una riga per ciascuna delle 7 categorie CategoryKey (brief audit,
// sezione 40 "dati strutturati"). I campi sotto (status/subScores/...)
// sono l'estensione additiva per l'audit multi-categoria: nullable,
// nessun dato storico esistente e' interessato.
model ScanScore {
  id       String @id @default(cuid())
  scanId   String
  scan     Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  category String
  score    Int
  weight   Float

  // Stato centralizzato (brief sezione 4): "excellent"|"good"|
  // "needs_improvement"|"poor"|"critical" — vedi src/lib/analysis/constants.ts.
  status String?
  // Sottopunteggi della categoria (brief sezioni 5-11, es. per SEO: On-page,
  // Technical SEO, Indexability, Structured Data, Internal Linking, Content
  // Signals): SubScore[] = [{key, label, score, weight}]. Json perche' la
  // forma cambia per categoria, come per GeoAnalysis.entities.
  subScores Json?
  notes String?
  // "verified"|"partial"|"unavailable"|"not_applicable" (brief sezione 34):
  // distingue dato misurato da stima, senza inventare un 0.
  dataAvailability String?
  // Una frase sintetica per la dashboard executive (brief sezione 14):
  // MAI problemi/consigli, solo descrizione generale.
  shortSummary String?
  // Metriche grezze rilevate (AnalysisResult.metrics — brief redesign PDF,
  // tabelle Security Headers/Performance gap): senza, un report
  // ricostruito da uno scan storico perdeva questi dati (restavano solo
  // nel report generato al momento dello scan). Json perche' la forma
  // cambia per categoria.
  metrics Json?
  // Punti di forza della SINGOLA categoria (AnalysisResult.strengths):
  // stesso motivo sopra, senza andavano perduti alla ricostruzione.
  strengths String[] @default([])

  @@index([scanId])
}

model ScanIssue {
  id             String        @id @default(cuid())
  scanId         String
  scan           Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  title          String
  description    String
  whyItMatters   String
  recommendation String
  evidence       String?
  category       String
  severity       IssueSeverity
  createdAt      DateTime      @default(now())

  @@index([scanId])
}

// Estesa (brief audit, sezione 42 "centralizzare le raccomandazioni") con i
// campi di un vero Recommendation: category/severity/explanation/impact/
// action/evidence. title+detail+priority restano per compatibilita' con le
// righe gia' persistite prima dell'audit multi-categoria (dove detail era
// una copia di title); le nuove colonne sono nullable e non toccano quelle
// righe storiche.
model Recommendation {
  id        String   @id @default(cuid())
  scanId    String
  scan      Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  title     String
  detail    String
  priority  Int
  category    String?
  severity    IssueSeverity?
  explanation String?
  impact      String?
  action      String?
  evidence    String?
  createdAt DateTime @default(now())

  @@index([scanId])
}

model Report {
  id         String   @id @default(cuid())
  scanId     String
  scan       Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  pdfUrl     String?
  publicSlug String?  @unique
  createdAt  DateTime @default(now())
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  plan                 PlanType  @default(FREE)
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// Limiti per piano, letti a runtime — mai hardcoded nella logica applicativa.
// maxScansWeek e maxSitesMonth si applicano solo al piano Free (1 analisi a
// settimana, 1 sito nuovo al mese); per il piano Pro restano null e non
// vengono applicati (siti illimitati, cap solo mensile via maxScansMonth).
model UsageLimit {
  id            String   @id @default(cuid())
  plan          PlanType @unique
  maxSites      Int
  maxScansMonth Int
  maxPagesScan  Int
  maxScansWeek  Int?
  maxSitesMonth Int?
  updatedAt     DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Sito a cui si riferisce la notifica: eliminando il sito spariscono anche
  // le sue notifiche. Null solo per notifiche non legate a un sito.
  siteId    String?
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([siteId])
}

// ---------------------------------------------------------------------
// Gestionale (piano Pro): integrazioni esterne e monitoraggio.
// Questi modelli esistono per rendere l'architettura pronta a collegare
// un provider reale (OAuth Google Analytics/Search Console, un servizio
// di uptime monitoring) — finche' non vengono configurate le credenziali
// necessarie, `connected` resta false e il Gestionale mostra
// esplicitamente "Connessione richiesta", mai dati finti.
// ---------------------------------------------------------------------

model AnalyticsConnection {
  id                   String    @id @default(cuid())
  siteId               String    @unique
  site                 Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  connected            Boolean   @default(false)
  // Proprieta' GA4 scelta dall'utente (solo l'id numerico, senza il prefisso
  // "properties/") tra quelle restituite da accountSummaries — vedi
  // src/lib/gestionale/analytics.ts. null finche' non viene scelta.
  propertyId           String?
  // Nome leggibile della proprieta', salvato alla scelta: l'id numerico da
  // solo non dice nulla a un cliente non tecnico.
  propertyName         String?
  accessToken          String?
  refreshToken         String?
  // Scadenza dell'accessToken corrente, per il refresh proattivo condiviso
  // con Search Console (vedi resolveGoogleAccessToken).
  accessTokenExpiresAt DateTime?
  connectedAt          DateTime?
  updatedAt            DateTime  @updatedAt
}

model SearchConsoleConnection {
  id                   String    @id @default(cuid())
  siteId               String    @unique
  site                 Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  connected            Boolean   @default(false)
  // Proprieta' Search Console scelta dall'utente tra quelle restituite da
  // sites.list (un account puo' averne piu' di una) — vedi
  // src/lib/gestionale/search-console.ts. null finche' non viene scelta:
  // "connesso" (token valido) e "proprieta' selezionata" sono stati
  // distinti, mostrati separatamente nel Gestionale.
  siteUrl              String?
  accessToken          String?
  refreshToken         String?
  // Scadenza dell'accessToken corrente: permette di rinnovarlo in modo
  // proattivo (vedi getValidSearchConsoleToken) invece di scoprirlo solo
  // dopo una risposta 401 da Google.
  accessTokenExpiresAt DateTime?
  connectedAt          DateTime?
  updatedAt            DateTime  @updatedAt
}

model MonitoringConfig {
  id         String   @id @default(cuid())
  siteId     String   @unique
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  configured Boolean  @default(false)
  provider   String?
  checkUrl   String?
  // ID del monitor sul provider esterno (es. UptimeRobot) — vedi
  // src/lib/integrations/uptimerobot.ts. Stringa, non Int: gli ID
  // UptimeRobot sono interi grandi e qui contano solo come riferimento
  // opaco, mai per calcoli. `configured` resta true solo quando questo
  // campo e' valorizzato (il monitor esiste davvero sul provider).
  monitorId  String?
  updatedAt  DateTime @updatedAt
}

// Monitor UptimeRobot di siti (o utenti) eliminati che non e' stato possibile
// eliminare sul provider al momento dell'eliminazione: il cron giornaliero
// riprova (vedi src/lib/gestionale/site-teardown.ts). Deliberatamente NON
// collegato a Site/User: deve sopravvivere alla loro eliminazione, altrimenti
// il monitor resterebbe orfano sul provider senza modo di ripulirlo.
model MonitorCleanup {
  id        String   @id @default(cuid())
  monitorId String   @unique
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Storico della conversazione con l'assistente AI per sito (piano Pro):
// permette di riprendere il contesto invece di perderlo a ogni refresh.
model AIConversation {
  id        String      @id @default(cuid())
  siteId    String
  site      Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AIMessage[]

  @@index([siteId, userId])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  text           String
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}
